noStringConversion = \
	JS_Eval \
	JS_NewString \
	JS_FreeCString

---

// Avoid types ending up in cnames.structs.* https://youtrack.jetbrains.com/issue/KT-49034

typedef struct JSContext {} JSContext;
typedef struct JSRuntime {} JSRuntime;

// Exposing non-constant macros per https://kotlinlang.org/docs/native-c-interop.html#macros

static inline int JsValueGetNormTag(JSValue v) {
  return JS_VALUE_GET_NORM_TAG(v);
}

static inline int JsValueGetInt(JSValue v) {
  return JS_VALUE_GET_INT(v);
}

static inline int64_t JsValueGetInt64(JSValue v) {
  return JS_VALUE_GET_INT(v);
}

static inline int JsValueGetBool(JSValue v) {
  return JS_VALUE_GET_BOOL(v);
}

static inline double JsValueGetFloat64(JSValue v) {
  return JS_VALUE_GET_FLOAT64(v);
}

static inline JSValue JsUndefined() {
  return JS_UNDEFINED;
}

static inline JSValue JsNull() {
  return JS_NULL;
}

static inline JSValue JsTrue() {
  return JS_TRUE;
}

static inline JSValue JsFalse() {
  return JS_FALSE;
}

// Things that could be written in Kotlin but were easier in C

static inline JSCFunctionListEntry JsCallFunction(void *func) {
  JSCFunctionListEntry entry = JS_CFUNC_DEF("call", 1, func);
  return entry;
}

static inline JSCFunctionListEntry JsDisconnectFunction(void *func) {
  JSCFunctionListEntry entry = JS_CFUNC_DEF("disconnect", 1, func);
  return entry;
}

static inline JSValue JsValueArrayToInstanceRef(JSValue* v, int i) {
  return v[i];
}

static inline JSValue JsNewTagInt(int val) {
  return JS_MKVAL(JS_TAG_INT, val);
}

static inline JSValue JsNewFloat64(double d) {
  return JS_NewFloat64(NULL, d);
}

// RDMA Changes helpers

static inline JSValue JsNewCFunction(JSContext* ctx, void* func, const char* name, int length) {
  return JS_NewCFunction(ctx, (JSCFunction*)func, name, length);
}

static inline void* JsGetOwnPropertyNames(JSContext* ctx, JSValueConst obj, int* count) {
  JSPropertyEnum *ptab;
  uint32_t plen;
  if (JS_GetOwnPropertyNames(ctx, &ptab, &plen, obj, JS_GPN_STRING_MASK) != 0) {
    *count = 0;
    return NULL;
  }
  *count = (int)plen;
  return ptab;
}

static inline const char* JsGetPropertyName(JSContext* ctx, void* ptab, int i) {
  return JS_AtomToCString(ctx, ((JSPropertyEnum*)ptab)[i].atom);
}

static inline JSValue JsGetPropertyAt(JSContext* ctx, JSValueConst obj, void* ptab, int i) {
  return JS_GetProperty(ctx, obj, ((JSPropertyEnum*)ptab)[i].atom);
}

static inline void JsFreePropertyEnum(JSContext* ctx, void* ptab) {
  js_free(ctx, ptab);
}
